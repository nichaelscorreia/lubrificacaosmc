# =========================================================================
# VARIÁVEIS DE AMBIENTE - SISTEMA DE CONTROLE DE LUBRIFICAÇÃO SMC
# =========================================================================

PORT=3000
NODE_ENV=production

# -------------------------------------------------------------------------
# MODO API TOMCAT (Recomendado para Deploy no Render / Nuvem)
# O app Node conecta na API Java hospedada no Apache Tomcat que acessa o Oracle
# -------------------------------------------------------------------------
LUBRIFICACAO_API_URL=http://nstech.ddns.net:8086/lubrificacao-api
LUBRIFICACAO_API_SECRET=insira_sua_chave_secreta_aqui_min_16_caracteres
API_TIMEOUT_MS=60000

# -------------------------------------------------------------------------
# MODO DIRETO ORACLE (Para desenvolvimento local ou rede direta)
# -------------------------------------------------------------------------
# ORACLE_USER=c##nstecholeo
# ORACLE_PASSWORD=nstech
# ORACLE_CONNECT_STRING=192.168.2.136:1521/xe

# -------------------------------------------------------------------------
# SEGURANÇA E SESSÃO
# -------------------------------------------------------------------------
JWT_SECRET=gere_uma_chave_jwt_forte_e_segura_aqui
JWT_EXPIRES_IN=24h
